# Copy this file to .env.local and fill in your Supabase values
# Get these from your Supabase project: Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (only for seed script — never expose in the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: override taxonomy Excel path for seed script
# TAXONOMY_PATH=C:/path/to/AdaptationTaxonomy.xlsx
